{
  "name": "monorepo-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/workspaces.mjs dev",
    "build": "npm run build --workspaces --if-present",
    "build:packages": "node scripts/workspaces.mjs build:packages",
    "build:playground": "node scripts/workspaces.mjs build:playground",
    "test": "npm test --workspaces --if-present",
    "test:watch": "node scripts/workspaces.mjs test:watch",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "checks": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "pack:check": "node scripts/workspaces.mjs pack:check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.3.1",
    "eslint": "^10.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
